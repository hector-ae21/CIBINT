@startuml
title Ciclo de inteligencia

skinparam backgroundColor transparent
skinparam shadowing false
skinparam defaultFontName Arial
skinparam roundcorner 14
skinparam ArrowColor #58595B
skinparam rectangle {
  BorderColor #0085CF
  FontColor #3E3E3D
}
rectangle "1 · Dirección y planificación\nDefinir la necesidad, el alcance y el plazo" as direccion #E9F6FB
rectangle "2 · Obtención\nReunir datos de fuentes autorizadas" as obtencion #BFE3F3
rectangle "3 · Procesamiento\nPreparar y relacionar la información" as procesamiento #E9F6FB
rectangle "4 · Análisis y producción\nInterpretar y elaborar la respuesta" as analisis #FFF2E6
rectangle "5 · Difusión\nComunicar el producto a tiempo" as difusion #EEF7E5
rectangle "6 · Retroalimentación\nRecoger la valoración del destinatario" as feedback #E9F6FB
rectangle "¿La necesidad está cubierta?" as decision #FFFFFF
rectangle "Cierre o seguimiento" as cierre #EEF7E5

direccion -down-> obtencion
obtencion -down-> procesamiento
procesamiento -down-> analisis
analisis -down-> difusion
difusion -down-> feedback
feedback -down-> decision
decision -right-> cierre : sí
decision -left-> direccion : ajustar preguntas o alcance

note right of obtencion
  Solo fuentes y técnicas
  autorizadas
end note

note right of analisis
  Distinguir hechos, inferencias
  y aspectos todavía inciertos
end note

@enduml
